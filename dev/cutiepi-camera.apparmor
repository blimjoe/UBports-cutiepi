# Native libcamera pipeline on the CM4; used only by camera policy group.
/dev/media[0-9]* rwk,
/dev/v4l-subdev[0-9]* rw,
/dev/dma_heap/* rw,
/sys/devices/platform/soc/** r,
/sys/devices/platform/scb/** r,
/sys/devices/platform/{gpu,v3dbus}/** r,
/sys/devices/virtual/dma_heap/** r,
/run/udev/data/** r,
/usr/share/libcamera/** r,
/usr/lib/aarch64-linux-gnu/libcamera/** mr,
/usr/libexec/libcamera/** rix,
owner @{PROC}/@{pid}/mountinfo r,
/sys/ r,
/sys/bus/ r,
/sys/class/ r,
/sys/class/{media,video4linux}/ r,
/sys/bus/media/** r,
/sys/bus/i2c/** r,
dbus (send, receive) bus=system path=/net/hadess/SensorProxy{,/**} peer=(name=net.hadess.SensorProxy),
